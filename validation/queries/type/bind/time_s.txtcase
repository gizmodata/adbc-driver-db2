// part: metadata

sort-keys = [["RES", "ascending"]]

[setup]
drop = "TEST_TIME"

[tags]
sql-type-name = "TIME"

// part: setup_query

CREATE TABLE test_time (
    idx INT,
    res TIME
);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "tts",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"RES": 0}
{"RES": null}
{"RES": 49531}
{"RES": 45045}
{"RES": 86399}
