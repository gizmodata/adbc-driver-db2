// part: metadata

[setup]
drop = "TEST_TIMESTAMPTZ"

[tags]
sql-type-name = "TIMESTAMP(6)"
caveats = ["Db2 for LUW has no TIMESTAMP WITH TIME ZONE: a time-zone-aware Arrow timestamp is stored in TIMESTAMP as UTC and reads back without a time zone"]

// part: setup_query

CREATE TABLE test_timestamptz (
    idx INT,
    res TIMESTAMP(6),
    res2 TIMESTAMP(6)
);

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "RES",
            "format": "tsu:",
            "flags": [
                "nullable"
            ]
        },
        {
            "name": "RES2",
            "format": "tsu:",
            "flags": [
                "nullable"
            ]
        }
    ]
}

// part: expected

{"RES": null, "RES2": null}
{"RES": -14182940000000, "RES2": -14182940000000}
{"RES": 946684800000000, "RES2": 946684800000000}
{"RES": 1684158330000000, "RES2": 1684158330000000}
{"RES": 253402300799999999, "RES2": 253402300799999999}
